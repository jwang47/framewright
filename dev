#!/bin/sh
# Run this checkout in dev mode: code changes restart the server and reload
# the page.
#
#   ./dev                  # browser, at http://localhost:8765
#   ./dev app              # Mac app window running this checkout live
#   ./dev --library PATH   # any other arguments go to python -m framewright
#
# Installs what's missing first: Python 3.10+ (via Homebrew) and, for
# `./dev app`, the Xcode command line tools.
set -eu
cd "$(dirname "$0")"

# The first Python 3.10+ on PATH or in the usual Mac locations.
find_python() {
  for py in python3 python3.14 python3.13 python3.12 python3.11 python3.10 \
      /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    if command -v "$py" >/dev/null 2>&1 &&
        "$py" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
      command -v "$py"
      return
    fi
  done
  return 1
}

if ! python=$(find_python); then
  if command -v brew >/dev/null 2>&1; then
    echo "Installing Python with Homebrew…"
    brew install python
    python=$(find_python)
  else
    echo "Framewright needs Python 3.10+. Install it from https://www.python.org/downloads/" >&2
    echo "or install Homebrew (https://brew.sh) and run ./dev again." >&2
    exit 1
  fi
fi

if [ "${1:-}" != app ]; then
  exec "$python" -m framewright "$@"
fi

if ! command -v swiftc >/dev/null 2>&1; then
  echo "Installing the Xcode command line tools; run ./dev app again when it finishes." >&2
  xcode-select --install || true
  exit 1
fi

# Rebuild only when the app is missing, points at another checkout, or
# macos/ changed since it was built.
app=dist/Framewright.app
plist=$app/Contents/Info.plist
if [ ! -f "$plist" ] || ! grep -q "<string>$PWD</string>" "$plist" ||
    [ -n "$(find macos -newer "$plist" | head -1)" ]; then
  macos/build.sh --dev
fi
open "$app"
